# 官方 CLI 的浏览器下载缓存（hyperframes browser ensure 写在 <cwd>/chrome/）。
# 它是本机产物而非仓库内容：一次 git add -A 就会把上百 MB 的 Chrome 压缩包提交进去。
chrome/

# 日志与问题账本
logs/
*.log

# 桌面运行时本地产物（画布素材、会话缓存）
.mavis/

# Python 产物
__pycache__/
*.py[cod]

# 密钥与环境（绝不入仓）
.env
.env.*
*.local

