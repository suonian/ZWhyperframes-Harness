# Shell/Node/Markdown must stay LF even on Windows with core.autocrlf=true.
* text=auto
*.sh text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.html text eol=lf
*.json text eol=lf
*.cff text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.woff2 binary
*.jpg binary
*.jpeg binary
*.png binary
*.mp3 binary
*.mp4 binary
